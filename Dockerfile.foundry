# Foundry hosted agent image. The platform requires linux/amd64 — build with
# --platform linux/amd64 on ARM hosts, or let `az acr build` handle it.
FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY host.py .

# The protocol library serves on 8088 and exposes /readiness itself.
EXPOSE 8088

CMD ["python", "host.py"]
