# Azure OpenAI / Azure AI Foundry model deployment (key auth).
# Either a Foundry project endpoint (https://<res>.services.ai.azure.com/api/projects/<proj>)
# or a classic Azure OpenAI endpoint (https://<res>.openai.azure.com) works --
# the code appends /openai/v1/ itself. Do NOT set an api-version; that path rejects it.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.services.ai.azure.com/api/projects/<your-project>
AZURE_OPENAI_API_KEY=<your-model-api-key>
AZURE_OPENAI_DEPLOYMENT_NAME=<your-chat-deployment-name>

# Azure AI Search index used as the knowledge base (key auth).
# CONTENT_FIELD must match the searchable text field in your index schema.
# SOURCE_FIELD is optional -- a field holding a URL/filename, used for citations.
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-query-key>
AZURE_SEARCH_INDEX_NAME=<your-index-name>
AZURE_SEARCH_CONTENT_FIELD=snippet
AZURE_SEARCH_SOURCE_FIELD=blob_url
AZURE_SEARCH_TOP_K=5

# Per-user document trimming. Leave false until SSO/OBO is wired and the index carries
# permission metadata -- true without a user token refuses every search (fail closed).
AZURE_SEARCH_ENFORCE_USER_ACL=false

# Debug surface for testing WITHOUT the bot channel. Requires an API key, sent as the
# X-API-Key header. Turn this OFF once the M365 Copilot channel is live.
ENABLE_DEBUG_CHAT_ENDPOINT=false
DEBUG_CHAT_API_KEY=

# Azure Bot credentials. Leave blank to run without the Copilot channel: /api/messages
# is then not registered at all. Set all three to enable it.
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=

# Deploy-time override: the agent version gets this Foundry connection placeholder
# instead of the literal key above, so no secret is stored on the version.
# Run check_foundry.py to find the connection name.
AZURE_SEARCH_API_KEY_REF=${{connections.itronekgsearch8sj38l.credentials.key}}
